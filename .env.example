# 认证配置（本文件为模板；复制为项目根目录 .env 后被自动读取，.env 已被 gitignore）

# 必填：Factory API 密钥（fk- 开头），永不过期
FACTORY_API_KEY=your_factory_api_key_here

# 可选：上游 x-factory-org-id 使用的 Factory 侧组织 ID
FACTORY_ORG_ID=your_factory_org_id

# 必填：客户端（酒馆 / AI harness）的独立 API Key；不要填写 Factory 密钥
# 使用足够长的随机字符串（可打印 ASCII，不含空白或逗号）
# 生成示例：node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
request_auth_token=your_private_request_token_here
